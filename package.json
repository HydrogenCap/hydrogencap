{
  "name": "hydrogencap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "VITE_ANALYZE=true vite build",
    "build:dev": "vite build --mode development",
    "check:edge": "node scripts/check-edge-functions.mjs",
    "test:edge": "deno test supabase/functions --allow-env",
    "lint": "eslint --max-warnings 0 src e2e scripts playwright.config.ts vitest.config.ts vite.config.ts tailwind.config.ts eslint.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/route-guards.spec.ts e2e/invite-pages.spec.ts e2e/shared-document.spec.ts",
    "e2e:ci": "playwright test --grep \"(mocked)|Smoke Tests|Navigation Smoke|Route Guards|Invite|Shared Document\"",
    "e2e:ui": "playwright test --ui",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:edge"
  },
