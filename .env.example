# ===========================================
# HydrogenCap Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Supabase (required)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Google Maps (required for map features)
# VITE_GOOGLE_MAPS_API_KEY="your-google-maps-key"

# Stripe (required for billing — use test keys for development)
# VITE_STRIPE_SOLO_PRODUCT_ID="prod_xxx"
# VITE_STRIPE_SOLO_PRICE_ID="price_xxx"
# VITE_STRIPE_PORTFOLIO_PRODUCT_ID="prod_xxx"
# VITE_STRIPE_PORTFOLIO_PRICE_ID="price_xxx"
# VITE_STRIPE_PRO_PRODUCT_ID="prod_xxx"
# VITE_STRIPE_PRO_PRICE_ID="price_xxx"

# Sentry (optional — error tracking in production)
# VITE_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# -----------------------------------------------
# Edge Function Secrets (set in Lovable Cloud)
# These are NOT used by the frontend — listed here
# for documentation only:
# -----------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY  (auto-injected)
# RESEND_API_KEY
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# COMPANIES_HOUSE_API_KEY
# CRON_SECRET
# FREEAGENT_CLIENT_ID
# FREEAGENT_CLIENT_SECRET
# FREEAGENT_STATE_SECRET  # 32+ random bytes, hex or base64; rotating invalidates all in-flight OAuth states
# COMPANY_SECRETS_KEY
